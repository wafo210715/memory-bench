# memory-bench 环境变量模板 —— `cp .env.example .env` 后填值。
# .env 已 gitignore；key 轮换只改 .env，本模板只维护"有哪些变量"。
# 每个臂各自必需哪些变量，见 servers.yaml 的 env_required（缺失时 smoke test 显式报缺，不静默降级）。

# 公平性 LLM 配置（interface-spec §7）：所有记忆系统共用，防"比配置不比记忆"
MEMBENCH_LLM_API_KEY=
MEMBENCH_LLM_BASE_URL=
MEMBENCH_LLM_MODEL=
MEMBENCH_EMBED_MODEL=
MEMBENCH_THINKING=
# mandol：cloud embedding 适配器重定向到智谱（mandol 硬编码 SiliconFlow 品牌名，仅借用其 env）
SILICONFLOW_EMBEDDINGS_URL=
SILICONFLOW_API_KEY=
# amem：llm_controller 走 OpenAI SDK env 约定 → 重定向到智谱
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 答题/判分 LLM（Linux vLLM via ngrok，Anthropic 兼容接口；2026-08-21 实测：单发 30k tok 7.2s，16 并发 16/16 成功，吞吐 ~10.7k tok/s）
# 注意：ngrok 免费隧道重启会换 URL，变更只改这里
MEMBENCH_ANSWER_BASE_URL=
MEMBENCH_ANSWER_API_KEY=
MEMBENCH_ANSWER_MODEL=
MEMBENCH_ANSWER_PROTOCOL=
# 判分模型（可选）：不设则复用 MEMBENCH_ANSWER_MODEL（bench-design §6.3 已定为同模型）
MEMBENCH_JUDGE_MODEL=
