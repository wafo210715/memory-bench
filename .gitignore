# ---- Python ----
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/

# ---- Virtual environments ----
# Three of them by necessity: mandol pins numpy<2 (conflicts with chromadb),
# a-mem installs the upstream repo with `pip -e`. See servers.yaml.
.venv/
.venv-*/

# ---- Node / Bun (servers/intent) ----
node_modules/

# ---- Secrets ----
# Key rotation happens in .env only; never commit it.
.env
.env.*
!.env.example

# ---- Memory-system state ----
# ~2GB of per-system stores and ingest snapshots. Rebuildable: re-ingest,
# or restore(tag) via the interface-spec snapshot/restore contract.
.state/

# ---- Run outputs ----
# Run *metadata* is tracked (manifest.json, system_stats.jsonl, failures.jsonl,
# ingest_progress, *.log) so provenance survives off-laptop.
# Bulk artifacts are not: answers.jsonl is ~58MB/run and evidence/ ~73MB/run.
# Archive those with scripts/archive_run.sh instead.
# 用 ** 匹配任意深度：runs/_archive/<run>/ 这类归档目录同样适用
runs/**/answers.jsonl
runs/**/evidence/
# MCP 调用 trace（2026-08-29 引入）：逐题一行 JSON，~2.7MB/arm/run（graphiti 实测 9.4MB）。
# 属于可重建的过程产物，与 answers/evidence 同类；需要时跟 run 一起归档。
runs/**/mcp_trace/

# 后台进程 PID：只对本机当次运行有意义，入库只会制造冲突
runs/**/*.pid

# nohup 重定向的原始运行日志：mandol 等系统的 INFO 刷屏，实测 8.2MB / 48,568 行每个 run。
# 有价值的部分（失败条目 + 判分结果）抽到同目录 run-summary.txt 且保留入库。
runs/**/run.log

# ---- Scratch ----
_to_delete/
archives/

# 编排脚本的原始输出：含 ingest/建塔全过程 INFO，实测 39MB / 26 万行每次全量跑。
# 有价值的阶段标记与建塔统计抽到同目录 orchestrator-summary.txt 保留入库。
runs/**/orchestrator.log

# ---- 2026-09-04 交接清理 ----
# r2 的原始运行日志（~220MB，72% trace 刷屏）：有价值的部分已抽到同目录 run-summary.txt
runs/**/logs/
# server 未设 MEMBENCH_RUN_ID 时落的散 trace（如裸跑 smoke）
runs/_mcp_trace/

# ---- flowgen ----
# 渲染产物与 A/B 对比临时页面；SVG 交付物提交到 servers/<sys>/assets/
servers/flowgen/out/

# ---- macOS ----
.DS_Store

# symlink 形态的 venv/node_modules（worktree 环境，目录型 pattern 不匹配 symlink）
.venv
servers/intent/node_modules
runs/*.nohup.log
